{
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "outDir": "lib",
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "target": "es2017",
        "skipLibCheck": true
    },
    "compileOnSave": false,
    "include": [
        "src"
    ]
}